{
  "name": "@kne-components/components-core",
  "version": "0.6.17",
  "files": [
    "build"
  ],
  "jest": {
    "moduleNameMapper": {
      "^@common/(.*)": "<rootDir>/src/common/$1",
      "^@components/(.*)": "<rootDir>/src/components/$1",
      "^@utils/(.*)": "<rootDir>/src/common/utils/$1",
      "^.+\\.(css|sass|scss|less)$": "identity-obj-proxy"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@kne/react-modal|@ant-design/icons|@ant-design/colors|@ant-design/fast-color|simplebar-react|simplebar)/)"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/components-core.git"
  },
  "dependencies": {
    "@kne/button-group": "^0.1.42",
    "@kne/compose": "^0.1.0",
    "@kne/create-deferred": "^0.1.1",
    "@kne/ensure-slash": "^0.1.0",
    "@kne/flex-box": "^0.1.2",
    "@kne/form-info": "^0.1.29",
    "@kne/global-context": "^1.3.2",
    "@kne/info-page": "^0.2.19",
    "@kne/is-empty": "^1.1.0",
    "@kne/phone-number-input": "^0.1.7",
    "@kne/react-enum": "^0.1.16",
    "@kne/react-fetch": "^1.5.7",
    "@kne/react-file": "^0.1.60",
    "@kne/react-file-type": "^1.0.9",
    "@kne/react-filter": "^2.0.7",
    "@kne/react-form-antd": "^4.1.11",
    "@kne/react-form-plus": "^0.1.9",
    "@kne/react-icon": "^0.1.4",
    "@kne/react-intl": "^0.1.16",
    "@kne/react-modal": "^0.1.15",
    "@kne/react-pdf-sign": "^1.1.9",
    "@kne/remote-loader": "^1.5.0",
    "@kne/responsive-utils": "^0.1.16",
    "@kne/scroll-loader": "^0.1.15",
    "@kne/super-select": "^0.1.54",
    "@kne/super-select-plus": "^0.1.5",
    "@kne/table-page": "^0.1.38",
    "@kne/use-click-outside": "^0.2.1",
    "@kne/use-control-value": "^0.1.9",
    "@kne/use-ref-callback": "^0.1.3",
    "@kne/use-simulation-blur": "^0.1.2",
    "axios": "^1.21.0",
    "classnames": "^2.3.2",
    "color": "^4.2.3",
    "dayjs": "^1.11.23",
    "lodash": "^4.17.23",
    "react": "^19.3.1",
    "react-avatar-editor": "^16.0.0",
    "react-dom": "^19.3.1",
    "react-intl": "^7.1.14",
    "react-router-dom": "^6.10.0",
    "simplebar": "^6.3.0",
    "simplebar-react": "^3.3.0",
    "use-debounce": "^9.0.4"
  },
  "scripts": {
    "lint-staged": "lint-staged",
    "create": "modules-dev-create",
    "start": "cross-env PORT=3001 COMPONENTS_NAME=components-core MODULES_DEV_PUBLIC_URL=/ craco start",
    "build": "cross-env COMPONENTS_NAME=components-core MODULES_DEV_PUBLIC_URL=/components-core  craco build",
    "test": "craco test --coverage",
    "build:docs": "modules-dev-build-docs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@kne/craco": "^7.1.4",
    "@kne/md-doc": "^0.1.27",
    "@kne/modules-dev": "^2.4.19",
    "@kne/react-error-boundary": "^0.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.3.3",
    "antd": "^6.6.8",
    "cross-env": "^7.0.3",
    "http-proxy-middleware": "^2.0.6",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.2",
    "prettier": "^2.8.4",
    "sass": "^1.107.1"
  }
}
